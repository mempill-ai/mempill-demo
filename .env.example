# mempill showcase — environment configuration
# Copy to .env and fill in. .env is gitignored; never commit real keys.
# All variables are optional unless otherwise noted.

# ── Agent identity ─────────────────────────────────────────────────────────────
# Agent/session owner ID used for all mempill memory operations.
# Default: jordan-park-001
MEMPILL_AGENT_ID=jordan-park-001

# ── Persistence ───────────────────────────────────────────────────────────────
# Base directory for a persistent SQLite-backed mempill engine.
# When set, the engine persists across restarts; seed is loaded only once
# (idempotency guard prevents Contested dupes on subsequent runs).
# The actual database file is derived as MEMPILL_DB_DIR/agent_{MEMPILL_AGENT_ID}.db.
# When unset (default): ephemeral in-memory engine (state lost on exit).
# Example: MEMPILL_DB_DIR=.mempill
# MEMPILL_DB_DIR=
#
# Dual-agent router / LangGraph Studio (people_ops_agent, org_registry_agent,
# dual_agent_router graphs, see studio_router_graph.py): when MEMPILL_DB_DIR is
# unset, these graphs default to "./.mempill" (NOT in-memory) so the per-agent
# SQLite files are visible on disk. First import creates two files:
#   .mempill/agent_people-ops-001.db
#   .mempill/agent_org-registry-001.db
# Inspect with: sqlite3 .mempill/agent_people-ops-001.db \
#   "select subject, predicate, value from claims;"
# (.mempill/ is gitignored — never commit these files.)

# ── Adapter toggle ─────────────────────────────────────────────────────────────
# Set to true to use NaiveAdapter (last-write-wins, no bi-temporal).
# Flip to watch the showcase misbehave vs. the mempill-backed path.
# Default: false (mempill bi-temporal engine)
# NAIVE_MODE=false

# ── Anthropic API ─────────────────────────────────────────────────────────────
# Required for the free-form ReAct agent LLM (tool-calling).
# Absent → deterministic mock path (no API calls, CI-safe).
ANTHROPIC_API_KEY=sk-ant-...

# Anthropic model for the ReAct agent.
# Canonical model setting — all LLM calls read this one var.
# Default: claude-haiku-4-5-20251001
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── LangSmith tracing (optional) ──────────────────────────────────────────────
# LangSmith API key. Absent → tracing is a no-op.
# LANGSMITH_API_KEY=

# Set to "true" to force-enable LangSmith tracing even if the key is present but
# the LANGSMITH_TRACING var is not set.
# LANGSMITH_TRACING=true

# LangSmith project name.
# Default: mempill-showcase
# LANGSMITH_PROJECT=mempill-showcase

# ── LangSmith endpoint (optional) ─────────────────────────────────────────────
# Override the LangSmith API endpoint (e.g. for self-hosted).
# Default: https://api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
