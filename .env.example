# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Required only for `--llm` mode (deterministic mode needs none).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the LLM model (default: claude-haiku-4-5-20251001). Cheaper: claude-haiku-4-5
MEMPILL_MODEL=claude-haiku-4-5-20251001
