{
  "_comment": "Claude Code project MCP config for mempill. Copy to .mcp.json at mempill-demo repo root (not tracked by git — see .gitignore). Replace /ABSOLUTE/PATH/TO/mempill-demo with your actual path. Claude Code supports ${VAR:-default} env var expansion for the env block. If MEMPILL_DB_PATH is unset, the server uses an in-memory (ephemeral) engine. IMPORTANT: uses the demo venv Python that already has the mempill wheel built.",
  "mcpServers": {
    "mempill": {
      "type": "stdio",
      "command": "/ABSOLUTE/PATH/TO/mempill-demo/.venv/bin/python",
      "args": [
        "-m",
        "mempill_mcp"
      ],
      "env": {
        "MEMPILL_AGENT_ID": "${MEMPILL_AGENT_ID:-demo-agent}",
        "MEMPILL_DB_PATH": "${MEMPILL_DB_PATH}"
      }
    }
  }
}
