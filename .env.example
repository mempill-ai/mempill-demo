# mempill showcase — environment configuration
# Copy to .env and fill in. .env is gitignored; never commit real keys.
# All variables are optional unless otherwise noted.

# ── Agent identity ─────────────────────────────────────────────────────────────
# Agent/session owner ID used for all mempill memory operations.
# Default: jordan-park-001
MEMPILL_AGENT_ID=jordan-park-001

# ── Persistence ───────────────────────────────────────────────────────────────
# File path for a persistent SQLite-backed mempill engine.
# When set, the engine persists across restarts; seed is loaded only once
# (idempotency guard prevents Contested dupes on subsequent runs).
# When unset (default): ephemeral in-memory engine (state lost on exit).
# Example: MEMPILL_DB_PATH=./showcase.db
# MEMPILL_DB_PATH=

# ── Adapter toggle ─────────────────────────────────────────────────────────────
# Set to true to use NaiveAdapter (last-write-wins, no bi-temporal).
# Flip to watch the showcase misbehave vs. the mempill-backed path.
# Default: false (mempill bi-temporal engine)
# NAIVE_MODE=false

# ── Anthropic API ─────────────────────────────────────────────────────────────
# Required for LLMSupervisor (intent classification) and LLMExtractor (claim extraction).
# Absent → MockSupervisor + shell heuristics (deterministic, no API calls, CI-safe).
ANTHROPIC_API_KEY=sk-ant-...

# Anthropic model for LLMSupervisor and LLMExtractor.
# Canonical model setting — ALL LLM components read this one var.
# Default: claude-haiku-4-5
# ANTHROPIC_MODEL=claude-haiku-4-5

# ── LangSmith tracing (optional) ──────────────────────────────────────────────
# LangSmith API key. Absent → tracing is a no-op.
# LANGSMITH_API_KEY=

# Set to "true" to force-enable LangSmith tracing even if the key is present but
# the LANGSMITH_TRACING var is not set.
# LANGSMITH_TRACING=true

# LangSmith project name.
# Default: mempill-showcase
# LANGSMITH_PROJECT=mempill-showcase

# ── LangSmith endpoint (optional) ─────────────────────────────────────────────
# Override the LangSmith API endpoint (e.g. for self-hosted).
# Default: https://api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
